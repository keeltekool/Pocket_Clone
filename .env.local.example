# Neon PostgreSQL
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Login password (one owner, no accounts)
APP_PASSWORD=change-me

# Anthropic (Managed Agents sorter, Fable 5.1)
ANTHROPIC_API_KEY=sk-ant-xxx

# iPhone Shortcut: x-api-key on POST /api/save
SHORTCUT_API_KEY=any-random-string

# Bearer token for /api/mcp (Claude Code + the agent's vault); 32 random bytes, base64url
MCP_TOKEN=any-random-string
